# Preserve source ignore boundaries for npm; local refactor material is never shipped.
node_modules/
dist/
coverage/
apps/*/dist/
apps/*/node_modules/
# product state (per project, never committed) — except the dogfood core-memory authority, which is tracked
.deckent/*
!.deckent/docs/
.deckent/docs/*
!.deckent/docs/core-memory/
.brain/
# product-generated host files (generated by `deckent init --host`, never committed)
DIRECTIVES.md
DECKENT.md
.gemini/
# native build artefacts (prebuilds are shipped via CI, not committed)
native/**/build/

# Refactor host kit is source; local credentials, sessions and hook state are not.
.claude/settings.local.json
.codex/tmp/
.claude/tmp/
.cursor/tmp/
.agents/refactor/state/
.agents/refactor/*.local.json
__pycache__/
*.pyc

# Adapter-owned native build artifacts; release binaries are copied into dist.
src/adapters/**/native/build/

# Local refactor observations and retired watcher state are not source snapshots.
.agents/refactor/owner-watch*
.agents/refactor/*-evidence.json
.agents/refactor/verification.json
.agents/refactor/verify-output.txt

# Owner-local refactor documents, evidence, experiments and toolchains.
/refactor-work/
