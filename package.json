{
  "name": "deckent",
  "version": "1.0.0-alpha.2",
  "description": "Provider-neutral, local-first AI agent orchestration runtime (Terminal \u00b7 MCP \u00b7 API)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "deckent": "./dist/composition/core/cli/internal/entry.js",
    "deckent-mcp": "./dist/composition/core/mcp/internal/entry.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "imports": {
    "#platform/*": "./dist/platform/*",
    "#domain/*": "./dist/domain/*",
    "#capabilities/*": "./dist/capabilities/*",
    "#engine/*": "./dist/engine/*",
    "#adapters/*": "./dist/adapters/*",
    "#surfaces/*": "./dist/surfaces/*",
    "#composition/*": "./dist/composition/*"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "native",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/package-metadata.mjs && npm run typecheck && eslint . && node scripts/lint-arch.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "smoke": "node dist/composition/core/cli/internal/entry.js --version",
    "verify": "npm run lint && npm run build && npm run test:native && npm run test && npm run test:host && npm run smoke",
    "test:native": "node scripts/test-native.mjs",
    "test:host": "node --test .agents/refactor/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^25.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
