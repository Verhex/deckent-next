{
  "name": "deckent",
  "version": "1.0.0-alpha.5",
  "description": "Provider-neutral, local-first AI agent orchestration runtime (Terminal · MCP · API)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "bin": {
    "deckent": "./dist/composition/core/cli/internal/entry.js",
    "deckent-mcp": "./dist/composition/core/mcp/internal/entry.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "imports": {
    "#platform/*": "./dist/platform/*",
    "#domain/*": "./dist/domain/*",
    "#capabilities/*": "./dist/capabilities/*",
    "#engine/*": "./dist/engine/*",
    "#adapters/*": "./dist/adapters/*",
    "#surfaces/*": "./dist/surfaces/*",
    "#composition/*": "./dist/composition/*"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "native",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "worker:image": "node assets/worker-image/build.mjs",
    "build": "node scripts/build.mjs",
    "build:terminal-tokens": "node scripts/build-terminal-palette.mjs",
    "build:bwrap": "node scripts/build-bwrap.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/package-metadata.mjs && node scripts/run-parallel.mjs \"npm run typecheck\" \"eslint .\" \"node scripts/lint-arch.mjs\" \"node scripts/lint-core-memory.mjs\"",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "smoke": "node dist/composition/core/cli/internal/entry.js --version",
    "build:dist": "node scripts/build-dist.mjs",
    "pack:dist": "node scripts/build-dist.mjs --pack",
    "smoke:dist": "node scripts/pack-smoke.mjs",
    "verify": "node scripts/verify-context.mjs && npm run lint && npm run build && npm run test:native && npm run test && npm run test:host && npm run smoke",
    "test:native": "node scripts/test-native.mjs",
    "test:host": "node --test --test-reporter=tap --test-concurrency=2 --test-timeout=180000 .agents/refactor/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "ink": "7.1.1",
    "react": "19.2.8",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "19.2.18",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
