    { "id": "daemon-unavailable", "version": 1, "status": "provisional", "action": "alert-brain", "graceMs": 120000 },
    { "id": "daemon-unavailable-escalate", "version": 1, "status": "provisional", "action": "hand-to-human", "afterMs": 900000 },
    { "id": "crash-loop", "version": 1, "status": "provisional", "action": "hand-to-human" },
    { "id": "policy-refusal-flood", "version": 1, "status": "provisional", "action": "alert-brain" }
