{
  "schemaVersion": 5,
  "recoveryDirectory": ".deckent-uninstall",
  "recoveryRoot": {
    "linux": {
      "environment": "XDG_STATE_HOME",
      "fallback": ".local/state",
      "path": "deckent/uninstall"
    },
    "wsl": {
      "environment": "XDG_STATE_HOME",
      "fallback": ".local/state",
      "path": "deckent/uninstall"
    },
    "darwin": {
      "environment": null,
      "fallback": "Library/Application Support",
      "path": "deckent/uninstall"
    },
    "win32": {
      "environment": "LOCALAPPDATA",
      "fallback": "AppData/Local",
      "path": "deckent/uninstall"
    }
  },
  "purgeMembers": {
    "ledger": "",
    "bindings": "",
    "policy": "",
    "installationIdentity": "identity.json",
    "approvals": "{keyFile}"
  },
  "treeMembers": {
    "audit": {
      "directory": "backup-operations",
      "proof": "sealed-audit-record"
    }
  },
  "cacheMembers": {
    "scratch": [
      "^[0-9a-f]{32}$",
      "^[0-9a-f]{32}$"
    ],
    "treeScanCache": [
      "^[a-f0-9]{64}\\.json$"
    ]
  },
  "sharedSecretFiles": [
    "secrets.json",
    "secrets.sealed.json",
    "secrets.key"
  ],
  "initialBackupPrefix": "initial-",
  "finalBackupPrefix": "final-",
  "systemctl": [
    "/usr/bin/systemctl",
    "/bin/systemctl"
  ],
  "git": [
    "/usr/bin/git",
    "/usr/local/bin/git",
    "/opt/homebrew/bin/git"
  ],
  "archive": {
    "conversation": [
      "terminalHistory",
      "terminalSessions",
      "runtimeLog",
      "ledgerBackups",
      "crashes",
      "approvalPreviews"
    ],
    "rootFiles": [
      "^\\.gitignore$",
      "^config\\.json\\.bak\\..+$",
      "^installation/retired\\.json$"
    ],
    "transient": [
      "^uninstall-hold\\.json$",
      "^state/ledger\\.db-(wal|shm|journal|lock)$",
      "^state/runtime\\.sock$"
    ],
    "companionSuffix": ".archive",
    "owner": "uninstall-files",
    "manifestSuffix": ".archive.json"
  }
}
