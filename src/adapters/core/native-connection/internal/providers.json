{
  "schemaVersion": 1,
  "limits": {
    "credentialBytes": 65536,
    "connections": 24,
    "headerBytes": 8192,
    "idleMs": 30000,
    "trafficBytes": 67108864,
    "eventBatchBytes": 262144,
    "maxEvents": 5000,
    "maxEventBytes": 4194304
  },
  "providers": {
    "codex": {
      "homeOverride": "CODEX_HOME",
      "home": ".codex",
      "file": "auth.json",
      "destinations": [
        "chatgpt.com",
        "auth.openai.com",
        "api.openai.com"
      ],
      "environment": {}
    },
    "claude": {
      "homeOverride": "CLAUDE_CONFIG_DIR",
      "home": ".claude",
      "file": ".credentials.json",
      "destinations": [
        "api.anthropic.com",
        "platform.claude.com"
      ],
      "environment": {
        "DISABLE_AUTOUPDATER": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      }
    },
    "cursor": {
      "homeOverride": "",
      "home": ".config/cursor",
      "file": "auth.json",
      "destinations": [
        "api2.cursor.sh",
        "api3.cursor.sh",
        "api4.cursor.sh",
        "api.cursor.com",
        "api.cursor.sh",
        "api5.cursor.sh",
        "api6.cursor.sh",
        "api7.cursor.sh",
        "api8.cursor.sh",
        "api9.cursor.sh"
      ],
      "environment": {
        "NODE_USE_ENV_PROXY": "1",
        "AGENT_CLI_CREDENTIAL_STORE": "file"
      },
      "credentialEnvironment": "CURSOR_AUTH_TOKEN"
    }
  },
  "quotaPolicy": {
    "schemaVersion": 1,
    "claudeRejectedStatuses": [
      "rejected"
    ],
    "codexPatterns": [
      "\\bquota (?:exceeded|exhausted)\\b",
      "\\brate[ _-]?limit(?:ed| exceeded| reached)\\b",
      "\\busage limit (?:exceeded|reached)\\b"
    ],
    "source": "https://raw.githubusercontent.com/anthropics/claude-agent-sdk-typescript/main/CHANGELOG.md",
    "sourceVersion": "0.3.280 (Claude Code 2.1.280)",
    "asOf": "2026-10-13",
    "codexEvidence": {
      "source": "https://developers.openai.com/codex/noninteractive",
      "asOf": "2026-10-13",
      "cliVersion": "unverified",
      "observation": "unverified; synthetic adapter fixtures only; no vendor quota capture"
    }
  }
}
