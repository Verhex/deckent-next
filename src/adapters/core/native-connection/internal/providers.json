{
  "schemaVersion": 1,
  "limits": {
    "credentialBytes": 65536,
    "connections": 24,
    "refusedHostsMax": 16,
    "headerBytes": 8192,
    "idleMs": 30000,
    "trafficBytes": 67108864,
    "eventBatchBytes": 262144,
    "maxEvents": 5000,
    "maxEventBytes": 4194304,
    "clientModelReport": {
      "pollMs": 100,
      "waitMs": 15000,
      "maxFileBytes": 4194304,
      "maxLineBytes": 1048576,
      "maxEntries": 256
    }
  },
  "providers": {
    "codex": {
      "homeOverride": "CODEX_HOME",
      "home": ".codex",
      "file": "auth.json",
      "dockerCustody": "relayed",
      "destinations": [
        "chatgpt.com",
        "auth.openai.com",
        "api.openai.com"
      ],
      "environment": {},
      "relay": {
        "source": "https://learn.chatgpt.com/docs/config-file/config-reference (model_providers.<id>.auth.*, read 2026-11-09); routes observed with codex-cli 0.166.0 placeholders 2026-11-08",
        "origin": "https://chatgpt.com",
        "basePath": "/backend-api/codex",
        "routes": [
          {
            "method": "GET",
            "path": "/models",
            "query": true
          },
          {
            "method": "POST",
            "path": "/responses",
            "query": false,
            "exclusive": true
          }
        ],
        "accountHeader": "chatgpt-account-id",
        "placeholder": "deckent-relay-placeholder",
        "capabilityBytes": 32,
        "requestBytes": 8388608,
        "responseBytes": 67108864,
        "maxRequests": 1024,
        "maxAbandoned": 4,
        "config": {
          "model_provider": "deckent_relay",
          "model_providers.deckent_relay.name": "Deckent relay",
          "model_providers.deckent_relay.base_url": "http://127.0.0.1:{shimPort}/backend-api/codex",
          "model_providers.deckent_relay.wire_api": "responses",
          "model_providers.deckent_relay.supports_websockets": false,
          "model_providers.deckent_relay.requires_openai_auth": false,
          "model_providers.deckent_relay.auth.command": "node",
          "model_providers.deckent_relay.auth.args": [
            "-e",
            "process.stdout.write(\"deckent-relay-placeholder\")"
          ],
          "model_providers.deckent_relay.auth.timeout_ms": 5000,
          "model_providers.deckent_relay.auth.refresh_interval_ms": 0
        }
      }
    },
    "claude": {
      "homeOverride": "CLAUDE_CONFIG_DIR",
      "home": ".claude",
      "file": ".credentials.json",
      "dockerCustody": "prohibited",
      "destinations": [
        "api.anthropic.com",
        "platform.claude.com"
      ],
      "environment": {
        "DISABLE_AUTOUPDATER": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      }
    },
    "cursor": {
      "homeOverride": "",
      "home": ".config/cursor",
      "file": "auth.json",
      "dockerCustody": "projected",
      "destinations": [
        "api2.cursor.sh",
        "api3.cursor.sh",
        "api4.cursor.sh",
        "api.cursor.com",
        "api.cursor.sh",
        "api5.cursor.sh",
        "api6.cursor.sh",
        "api7.cursor.sh",
        "api8.cursor.sh",
        "api9.cursor.sh"
      ],
      "environment": {
        "NODE_USE_ENV_PROXY": "1",
        "AGENT_CLI_CREDENTIAL_STORE": "file"
      },
      "credentialEnvironment": "CURSOR_AUTH_TOKEN"
    }
  },
  "quotaPolicy": {
    "schemaVersion": 1,
    "claudeAllowedStatuses": ["allowed", "allowed_warning"],
    "claudeRejectedStatuses": [
      "rejected"
    ],
    "codexPatterns": [
      "\\bquota (?:exceeded|exhausted)\\b",
      "\\brate[ _-]?limit(?:ed| exceeded| reached)\\b",
      "\\busage limit (?:exceeded|reached)\\b"
    ],
    "source": "https://raw.githubusercontent.com/anthropics/claude-agent-sdk-typescript/main/CHANGELOG.md",
    "sourceVersion": "0.3.280 (Claude Code 2.1.280)",
    "asOf": "2026-10-13",
    "codexEvidence": {
      "source": "https://developers.openai.com/codex/noninteractive",
      "asOf": "2026-10-13",
      "cliVersion": "unverified",
      "observation": "unverified; synthetic adapter fixtures only; no vendor quota capture"
    }
  }
}
