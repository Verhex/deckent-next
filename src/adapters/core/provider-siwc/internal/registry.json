{
  "schemaVersion": 2,
  "source": "https://developers.openai.com/siwc/token-sharing-open-source/sign-in",
  "observedOn": "2026-10-25",
  "issuer": "https://auth.openai.com",
  "dynamicClientId": "dynamic_agent_client",
  "authorizationEndpoint": "https://auth.openai.com/api/accounts/authorize",
  "tokenEndpoint": "https://auth.openai.com/api/accounts/oauth/token",
  "discoveryEndpoint": "https://auth.openai.com/.well-known/openid-configuration",
  "resource": "https://api.openai.com/v1",
  "appName": "Deckent",
  "identityScopes": [
    "openid",
    "profile",
    "email"
  ],
  "usageScopes": [
    "offline_access",
    "resource.invoke",
    "chatgpt.tokens.use.direct"
  ],
  "usagePermission": "chatgpt.tokens.use.direct",
  "callbackPath": "/auth/callback",
  "hostSecretName": "SIWC_HOST_ID",
  "connectionSecretPrefix": "DECKENT_CREDENTIAL_SESSION_SIWC_",
  "encryptedStoreId": "core.secret-store.encrypted-file@1",
  "timeoutMs": 120000,
  "maxPending": 4,
  "maxConnections": 64,
  "limits": {
    "loginWindowMs": 120000,
    "httpTimeoutMs": 15000,
    "responseMaxBytes": 65536,
    "jwtMaxBytes": 32768,
    "maxKeys": 64,
    "callbackMaxBytes": 8192,
    "callbackMaxConnections": 32
  },
  "terminalRefreshErrors": [
    "invalid_grant",
    "invalid_refresh_token",
    "token_expired",
    "refresh_token_expired",
    "refresh_token_invalidated",
    "refresh_token_reused"
  ],
  "refreshMarginMs": 60000,
  "refreshLockWaitMs": 60000,
  "refreshPolicySource": {
    "source": "https://developers.openai.com/siwc/token-sharing-open-source/profiles-and-sessions",
    "observedOn": "2026-10-25",
    "kind": "deckent-policy"
  },
  "usageSummary": {
    "days": 30,
    "source": "https://developers.openai.com/siwc/ui-ux-guidelines",
    "observedOn": "2026-10-25"
  },
  "inference": {
    "adapter": {
      "id": "siwc-responses",
      "version": 1
    },
    "endpoint": "https://api.openai.com/v1/responses",
    "modelsEndpoint": "https://api.openai.com/v1/models",
    "modelsMaxEntries": 128,
    "modelsMaxBytes": 262144,
    "visibility": "list",
    "namespace": {
      "name": "deckent",
      "description": "Tools provided by the connected application."
    },
    "source": "https://developers.openai.com/siwc/token-sharing-open-source/models-and-inference",
    "observedOn": "2026-10-25",
    "modelFieldMaxChars": 1024
  },
  "requestRules": {
    "source": "https://developers.openai.com/siwc/token-sharing-open-source/preview-limitations",
    "observedOn": "2026-10-25",
    "allowedFields": [
      "model",
      "input",
      "instructions",
      "tools",
      "store",
      "stream"
    ],
    "unverifiedFields": [
      "reasoning",
      "tool_choice",
      "include"
    ],
    "forbiddenFields": [
      "background",
      "conversation",
      "max_output_tokens",
      "max_tool_calls",
      "metadata",
      "moderation",
      "multi_agent",
      "prompt",
      "prompt_cache_retention",
      "safety_identifier",
      "temperature",
      "top_logprobs",
      "top_p",
      "truncation",
      "user",
      "previous_response_id",
      "service_tier"
    ],
    "store": false,
    "stream": true
  },
  "usageErrors": {
    "source": "https://developers.openai.com/siwc/token-sharing-open-source/errors-and-recovery",
    "observedOn": "2026-10-25",
    "codes": {
      "subscription_sharing_usage_limit_exceeded": "quota",
      "subscription_sharing_usage_unavailable": "quota",
      "subscription_sharing_user_not_eligible": "plan-unavailable",
      "subscription_sharing_invalid_user": "login-required"
    }
  }
}
