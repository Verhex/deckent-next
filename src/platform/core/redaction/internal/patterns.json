{
  "knownLabel": {
    "prefix": "\u2039secret:",
    "suffix": "\u203a",
    "anonymous": "[REDACTED]"
  },
  "patterns": [
    {
      "id": "provider-token",
      "gate": true,
      "source": "\\b(?:sk-(?:ant-)?[\\w-]+|gh[pousr]_[\\w]+|github_pat_[\\w]+|AKIA[A-Z0-9]{16}|xox[abp]-[A-Za-z0-9_-]{8,}|npm_[A-Za-z0-9]+|AIza[A-Za-z0-9_-]+)\\b",
      "flags": "g",
      "replacement": "[REDACTED]",
      "streamPreviewSource": "\\b(?:sk-(?:ant-)?[\\w-]*|gh[pousr]_\\w*|github_pat_\\w*|AKIA[A-Z0-9]*|xox[abp]-[A-Za-z0-9_-]*|npm_[A-Za-z0-9]*|AIza[A-Za-z0-9_-]*)$"
    },
    {
      "id": "bearer-token",
      "gate": true,
      "source": "(Bearer\\s+)[A-Za-z0-9._~+/=-]{16,}",
      "recordSource": "(Bearer\\s+)\\S+",
      "flags": "gi",
      "replacement": "$1[REDACTED]",
      "streamSource": "\\bBearer\\s*$"
    },
    {
      "id": "url-userinfo",
      "gate": true,
      "source": "(\\b[a-z][a-z0-9+.-]{0,31}://[^\\s/@:|\\x60\\x22<>?#]+:)[^\\s/@|\\x60\\x22<>?#]+(@)",
      "flags": "gi",
      "replacement": "$1[REDACTED]$2",
      "streamPreviewSource": "(\\b[a-z][a-z0-9+.-]{0,31}://[^\\s/@:|\\x60\\x22<>?#]+:)[^\\s/@|\\x60\\x22<>?#]*(@?)$"
    },
    {
      "id": "key-value",
      "gate": false,
      "source": "((?<![\\w-])(?:[\\w-]*(?:password|passwd|token|secret|api[_-]?key|private[_-]?key)|authorization|cookie)\\s*=\\s*)[^\\s;|&$()\\x60\\x27\\x22<>]+",
      "flags": "gi",
      "replacement": "$1[REDACTED]",
      "streamSource": "(?<![\\w-])(?:[\\w-]*(?:password|passwd|token|secret|api[_-]?key|private[_-]?key)|authorization|cookie)\\s*(?:=\\s*)?$"
    },
    {
      "id": "jwt",
      "gate": true,
      "source": "\\beyJ[\\w-]+\\.[\\w-]+\\.[\\w-]+\\b",
      "flags": "g",
      "replacement": "[REDACTED]",
      "streamPreviewSource": "\\beyJ[\\w-]*(?:\\.[\\w-]*){0,2}$"
    }
  ],
  "configSecret": {
    "id": "config-secret",
    "note": "S6 pre-dispatch gate only (redaction ignores it): the key-value vocabulary narrowed to config-like files and non-placeholder literal values. key-value itself stays gate:false (it matches ordinary code).",
    "files": [
      ".env",
      ".env.*",
      "*.json",
      "*.yaml",
      "*.yml",
      "*.toml",
      "*.ini",
      "*.properties",
      "*.conf",
      "*.cfg",
      "*.xml",
      "docker-compose*",
      "*.config"
    ],
    "keys": [
      "password",
      "passwd",
      "pwd",
      "secret",
      "token",
      "api[_-]?key",
      "private[_-]?key",
      "access[_-]?key",
      "credentials?",
      "connection[_-]?string",
      "authorization",
      "cookie"
    ],
    "assignmentSource": "(?<![\\w.-])[\"']?([\\w.-]*(?:{keys}))[\"']?[ \\t]*[:=](?:[ \\t]*|\\s*(?=[\"']))(?:\"([^\"\\r\\n]*)\"|'([^'\\r\\n]*)'|(\\$\\{[^}\\r\\n]*\\}|<[^>\\r\\n]*>|[^\\s\"',;#}\\]<]+))",
    "elementSource": "<(?:[\\w.-]+:)?([\\w.-]*(?:{keys}))(?:\\s[^>]*)?>([^<\\r\\n]*)</",
    "flags": "gi",
    "placeholders": [
      "^\\$\\{[^}]*\\}$",
      "^\\$\\(?[A-Za-z_][A-Za-z0-9_]*\\)?$",
      "^%[^%]+%$",
      "^<[^>]*>$",
      "^\\{\\{.*\\}\\}$",
      "^\\*+$",
      "^[xX]+$",
      "^(?:changeme|change[_-]?me|change[_-]?it|example|dummy|redacted|placeholder|null|none|nil|true|false|todo|tbd|fixme|secret|password|your[_-].*|xxx.*|\\.\\.\\.)$"
    ],
    "minValueLength": 6
  }
}
