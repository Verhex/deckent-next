{
  "knownLabel": {
    "prefix": "\u2039secret:",
    "suffix": "\u203a",
    "anonymous": "[REDACTED]"
  },
  "patterns": [
    {
      "id": "provider-token",
      "gate": true,
      "source": "\\b(?:sk-(?:ant-)?[\\w-]+|gh[pousr]_[\\w]+|github_pat_[\\w]+|AKIA[A-Z0-9]{16}|xox[abp]-[A-Za-z0-9_-]{8,}|npm_[A-Za-z0-9]+|AIza[A-Za-z0-9_-]+)\\b",
      "flags": "g",
      "replacement": "[REDACTED]",
      "streamPreviewSource": "\\b(?:sk-(?:ant-)?[\\w-]*|gh[pousr]_\\w*|github_pat_\\w*|AKIA[A-Z0-9]*|xox[abp]-[A-Za-z0-9_-]*|npm_[A-Za-z0-9]*|AIza[A-Za-z0-9_-]*)$"
    },
    {
      "id": "bearer-token",
      "gate": true,
      "source": "(Bearer\\s+)[A-Za-z0-9._~+/=-]{16,}",
      "recordSource": "(Bearer\\s+)\\S+",
      "flags": "gi",
      "replacement": "$1[REDACTED]",
      "streamSource": "\\bBearer\\s*$"
    },
    {
      "id": "url-userinfo",
      "gate": true,
      "source": "(\\b[a-z][a-z0-9+.-]{0,31}://[^\\s/@:|\\x60\\x22<>?#]+:)[^\\s/@|\\x60\\x22<>?#]+(@)",
      "flags": "gi",
      "replacement": "$1[REDACTED]$2",
      "streamPreviewSource": "(\\b[a-z][a-z0-9+.-]{0,31}://[^\\s/@:|\\x60\\x22<>?#]+:)[^\\s/@|\\x60\\x22<>?#]*(@?)$"
    },
    {
      "id": "key-value",
      "gate": false,
      "source": "((?<![\\w-])(?:[\\w-]*(?:password|passwd|token|secret|api[_-]?key|private[_-]?key)|authorization|cookie)\\s*=\\s*)[^\\s;|&$()\\x60\\x27\\x22<>]+",
      "flags": "gi",
      "replacement": "$1[REDACTED]",
      "streamSource": "(?<![\\w-])(?:[\\w-]*(?:password|passwd|token|secret|api[_-]?key|private[_-]?key)|authorization|cookie)\\s*(?:=\\s*)?$"
    },
    {
      "id": "jwt",
      "gate": true,
      "source": "\\beyJ[\\w-]+\\.[\\w-]+\\.[\\w-]+\\b",
      "recordSource": "((?<![\\w-])(?:(?!\\beyJ)[\\w-])*)\\beyJ[\\w-]+\\.[\\w-]+\\.[\\w-]+\\b",
      "flags": "g",
      "replacement": "$1[REDACTED]",
      "streamPreviewSource": "((?<![\\w-])(?:(?!\\beyJ)[\\w-])*)\\beyJ[\\w-]*(?:\\.[\\w-]*){0,2}$"
    }
  ],
  "gatePatterns": [
    {
      "id": "private-key-block",
      "source": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----",
      "flags": ""
    },
    {
      "id": "gitlab-token",
      "source": "\\bglpat-[A-Za-z0-9_-]{20,}",
      "flags": ""
    },
    {
      "id": "aws-temporary-key",
      "source": "\\bASIA[A-Z0-9]{16}\\b",
      "flags": ""
    },
    {
      "id": "aws-secret-key",
      "source": "aws_?secret_?access_?key[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9/+=]{40}(?![A-Za-z0-9/+=])",
      "flags": "i"
    },
    {
      "id": "stripe-key",
      "source": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}",
      "flags": ""
    },
    {
      "id": "slack-token",
      "source": "\\b(?:xox[a-z]|xapp)-[A-Za-z0-9-]{8,}",
      "flags": ""
    },
    {
      "id": "pypi-token",
      "source": "\\bpypi-[A-Za-z0-9_-]{50,}",
      "flags": ""
    },
    {
      "id": "azure-account-key",
      "source": "\\b(?:AccountKey|SharedAccessKey)=[A-Za-z0-9+/]{20,}={0,2}",
      "flags": "i"
    }
  ],
  "configSecret": {
    "id": "config-secret",
    "note": "S6 pre-dispatch gate only (redaction ignores it): the key-value vocabulary narrowed to config-like files and non-placeholder literal values. key-value itself stays gate:false (it matches ordinary code).",
    "files": [
      ".env",
      ".env.*",
      "*.json",
      "*.yaml",
      "*.yml",
      "*.toml",
      "*.ini",
      "*.properties",
      "*.conf",
      "*.cfg",
      "*.xml",
      "docker-compose*",
      "*.config"
    ],
    "keys": [
      "password",
      "passwd",
      "pwd",
      "secret",
      "token",
      "api[_-]?key",
      "private[_-]?key",
      "access[_-]?key",
      "account[_-]?key",
      "shared[_-]?access[_-]?key",
      "credentials?",
      "connection[_-]?string",
      "authorization",
      "cookie"
    ],
    "assignmentSource": "(?<![\\w.-])[\"']?([\\w.-]*(?:{keys}))[\"']?[ \\t]*[:=](?:[ \\t]*|\\s*(?=[\"']))(?:\"([^\"\\r\\n]*)\"|'([^'\\r\\n]*)'|(\\$\\{\\{[^}\\r\\n]*\\}\\}(?=(?:[ \\t]+#[^\\r\\n]*)?[ \\t]*(?:\\r\\n|\\r|\\n|$))|\\$\\{[^}\\r\\n]*\\}|<[^>\\r\\n]*>|[^\\s\"',;#}\\]<]+))",
    "elementSource": "<(?:[\\w.-]+:)?([\\w.-]*(?:{keys}))(?:\\s[^<>]*)?>([^<\\r\\n]*)</",
    "flags": "gi",
    "placeholders": [
      "^\\$\\{[A-Za-z_][A-Za-z0-9_]*(?::?\\?[^}]*)?\\}$",
      "^\\$\\(?[A-Za-z_][A-Za-z0-9_]*\\)?$",
      "^%[A-Za-z_][A-Za-z0-9_]*%$",
      "^<[^<>]*>$",
      "^\\{\\{[^'\"{}]*\\}\\}$","^\\$\\{\\{[ \\t]*(?:github|secrets|env|vars|inputs|steps|needs|matrix|runner|job|strategy)\\.[A-Za-z0-9_.\\-]+[ \\t]*\\}\\}$",
      "^\\*+$",
      "^[xX]+$",
      "^(?:changeme|change[_-]?me|change[_-]?it|example|dummy|redacted|placeholder|null|none|nil|true|false|todo|tbd|fixme|secret|password|your[_-][\\w-]*|xxx[\\w-]*|\\.\\.\\.)$"
    ],
    "minValueLength": 6,
    "envDefaultSource": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*:?[-=](.*)\\}$"
  }
}
