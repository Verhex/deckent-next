{
  "schemaVersion": 1,
  "enabled": false,
  "maxSubscribers": 16,
  "maxSubscribersPerPrincipal": 8,
  "maxViews": 16,
  "maxObservedScopes": 8,
  "subscriberMaxEvents": 256,
  "subscriberMaxBytes": 1048576,
  "viewReplayMaxEvents": 512,
  "viewReplayMaxBytes": 2097152,
  "resumeTtlMs": 60000,
  "readPageSize": 64,
  "maxSnapshotRows": 2048,
  "maxSnapshotBytes": 4194304,
  "snapshotDeadlineMs": 5000,
  "snapshotRetryLimit": 2,
  "heartbeatMs": 10000,
  "idleTimeoutMs": 30000,
  "drainTimeoutMs": 5000,
  "closeGraceMs": 1000,
  "authorizationRefreshMs": 1000,
  "reconcileIntervalMs": 200,
  "maxConcurrentHydrations": 2,
  "liveWorkerMaxEvents": 256,
  "liveWorkerMaxBytes": 262144,
  "liveWorkerFlushMs": 200
}
