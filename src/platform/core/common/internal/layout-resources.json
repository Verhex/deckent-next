{
  "schemaVersion": 4,
  "rootName": ".deckent",
  "resources": {
    "config": "config.json",
    "installationJournal": "installation/journal.json",
    "installationIdentity": "installation-identity",
    "projectIdentity": "project-identity",
    "brain": "brain",
    "memory": "brain/memory.db",
    "tasks": "tasks",
    "runs": "runs",
    "locks": "locks",
    "approvals": "approvals",
    "audit": "audit",
    "artifacts": "artifacts",
    "integrations": "integrations",
    "crashes": "crashes",
    "ledger": "state/ledger.db",
    "workspaces": "workspaces",
    "policy": "policy.json",
    "bindings": "bindings.json",
    "runtimeSocket": "state/runtime.sock",
    "runtimeLog": "state/runtime-service.log",
    "ledgerBackups": "state/backups",
    "terminalHistory": "state/terminal-history.jsonl",
    "terminalSessions": "state/terminal-sessions",
    "fileEffects": "state/file-effects",
    "approvalPreviews": "state/approval-previews",
    "scratch": "state/scratch",
    "instructionTrust": "state/instruction-trust",
    "treeScanCache": "state/tree-scan-cache",
    "autonomyShadow": "state/autonomy-shadow",
    "memoryPurges": "state/memory-purges",
    "signers": "signers",
    "brainWaits": "state/brain-waits",
    "headlessLogins": "headless/logins",
    "workerImageBuilders": "state/worker-image-builders",
    "onboarding": "state/onboarding.json",
    "compileCache": "state/compile-cache"
  },
  "bootstrapResource": "config",
  "fixedResources": [
    "config",
    "installationJournal",
    "projectIdentity"
  ],
  "rootEnvironmentKey": "DECKENT_HOME",
  "globalRootEnvironmentKey": "DECKENT_GLOBAL_HOME",
  "compileCacheOffEnvironmentKey": "DECKENT_DISABLE_COMPILE_CACHE",
  "compileCacheWritersDirectory": "writers",
  "compileCacheRemovalFence": "removing"
}
