{
  "schemaVersion": 1,
  "groups": {
    "cache": ["scratch", "treeScanCache", "bwrap-realm", "build-cache"],
    "work": ["global-data", "ledger", "audit", "approvals", "runs", "tasks", "artifacts", "fileEffects", "approvalPreviews", "autonomyShadow", "memoryPurges", "brainWaits", "integrations", "crashes", "locks", "brain", "memory"],
    "settings": ["config", "policy", "bindings", "installationJournal", "onboarding", "signers", "instructionTrust"],
    "identity": ["installationIdentity", "projectIdentity"],
    "history": ["terminalHistory", "terminalSessions", "runtimeLog"],
    "backups": ["ledgerBackups"],
    "workspaces": ["workspaces"],
    "service": ["runtimeSocket", "recorded-service", "unrecorded-service"],
    "shared": ["global-home", "headlessLogins", "workerImageBuilders"]
  },
  "prefixes": { "image.": "images", "shared.": "shared" },
  "sharedGroups": ["shared", "images"],
  "listedLimit": 5
}
