{
  "groups": [
    "setup",
    "security",
    "work",
    "tools",
    "data"
  ],
  "retirementStates": [
    "deprecated",
    "retired"
  ],
  "backupPassphraseName": "BACKUP_PASSPHRASE",
  "nativePluginScan": { "pageSize": 50, "maxRecords": 1000 },
  "nativePluginRowsShown": 5,
  "pendingRoleRowsShown": 5,
  "headlessRefusedHostsShown": 5,
  "imageRefreshRepeats": [
    "WORKER_IMAGE_CONSENT_MISSING"
  ],
  "fixes": [
    {
      "id": "toolchain-update",
      "checks": [
        "tools.toolchains"
      ],
      "port": "updateToolchains",
      "hardFloor": false
    },
    {
      "id": "installation-directory-private",
      "checks": [
        "security.directory"
      ],
      "port": "repairInstallationDirectory",
      "hardFloor": false,
      "policyAction": "installation/repair"
    },
    {
      "id": "audit-rebaseline",
      "checks": [
        "security.audit"
      ],
      "port": "rebaselineAudit",
      "hardFloor": true
    }
  ]
}
