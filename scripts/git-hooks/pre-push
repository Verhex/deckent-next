#!/usr/bin/env bash
# Tracked hook; enabled per checkout by `npm run hooks:install`.
# Marked landing pushes read existing exact-SHA GitHub checks; they never launch a full local suite.
# Unmarked author pushes remain lightweight; GitHub rules enforce required integration checks.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
targets=()
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  [ "$local_sha" = "$zero" ] && continue          # deletion
  [[ "$local_sha" =~ ^0+$ ]] && continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/wave/*) targets+=("$remote_ref $local_sha") ;;
  esac
done
[ ${#targets[@]} -gt 0 ] || exit 0
if [ "${DECKENT_LANDING:-}" != 1 ]; then
  echo "pre-push: not a landing push (set DECKENT_LANDING=1 to run land:check); no CI mirror run" >&2
  exit 0
fi
for target in "${targets[@]}"; do
  sha="${target#* }"
  echo "pre-push: land:check for ${target% *} @ $sha" >&2
  node scripts/land-hosted-check.mjs --ref "$sha" || { echo "pre-push: land:check failed; push aborted (required hosted checks must be green)" >&2; exit 1; }
done
