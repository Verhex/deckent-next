{
  "schemaVersion": 3,
  "repository": "deckent/worker",
  "baseRepository": "deckent/worker-base",
  "base": {
    "image": "node:24-trixie-slim",
    "apt": [
      "git",
      "curl",
      "ca-certificates",
      "ripgrep",
      "python3",
      "make",
      "g++"
    ]
  },
  "providers": [
    {
      "id": "codex",
      "installer": {
        "kind": "npm",
        "package": "@openai/codex"
      },
      "command": "codex",
      "helpArgs": [
        "exec",
        "--help"
      ],
      "requiredFlags": [
        "--json",
        "--model",
        "--dangerously-bypass-approvals-and-sandbox",
        "--ignore-user-config"
      ]
    },
    {
      "id": "claude",
      "installer": {
        "kind": "npm",
        "package": "@anthropic-ai/claude-code"
      },
      "command": "claude",
      "helpArgs": [
        "--help"
      ],
      "requiredFlags": [
        "--output-format",
        "--model",
        "--dangerously-skip-permissions",
        "--safe-mode",
        "--settings"
      ]
    },
    {
      "id": "cursor",
      "installer": {
        "kind": "vendor-script",
        "url": "https://cursor.com/install",
        "home": "/opt/cursor-agent",
        "bin": [
          "cursor-agent",
          "agent"
        ]
      },
      "command": "cursor-agent",
      "helpArgs": [
        "--help"
      ],
      "requiredFlags": [
        "--output-format",
        "--model",
        "--force",
        "--trust"
      ]
    }
  ],
  "imageVersion": "r4-20260930",
  "previousVersion": "r3-20260922",
  "npmRegistry": "https://registry.npmjs.org"
}
