{
  "schemaVersion": 3,
  "instructionSurface": {
    "hiddenPaths": [
      "AGENTS.md",
      "CLAUDE.md",
      ".agents",
      ".claude",
      ".codex",
      ".cursor",
      "/DECKENT.md",
      "/.deckent/worker-instructions.md"
    ]
  },
  "adapters": {
    "codex": {
      "executable": "codex",
      "args": [
        "exec",
        "--json",
        "--color",
        "never",
        "--ignore-user-config",
        "-c",
        "check_for_update_on_startup=false",
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "modelFlag": "--model",
      "helpArgs": [
        "exec",
        "--help"
      ],
      "disabledArgs": [
        "--strict-config",
        "-c",
        "skills.include_instructions=false",
        "-c",
        "skills.bundled.enabled=false"
      ],
      "coreArgs": [
        "-c",
        "model_instructions_file=\"/tmp/deckent-prompt/core.txt\"",
        "-c",
        "project_doc_max_bytes=0"
      ],
      "modelAliases": [],
      "capabilities": {
        "maxTurns": null,
        "settings": null,
        "discovery": {
          "requiredFlags": [
            "--strict-config",
            "--config"
          ],
          "hiddenProbes": [
            {
              "args": [
                "exec",
                "--strict-config",
                "-c",
                "skills.include_instructions=deckent-probe"
              ],
              "refusal": "expected a boolean\nin `skills.include_instructions`"
            },
            {
              "args": [
                "exec",
                "--strict-config",
                "-c",
                "skills.bundled.enabled=deckent-probe"
              ],
              "refusal": "expected a boolean\nin `skills.bundled.enabled`"
            }
          ],
          "checkout": null
        },
        "promptChannel": "codex-instructions-file",
        "eventStream": "codex-exec-json",
        "structuredReport": {
          "flag": "--output-schema",
          "channel": "schema-file"
        },
        "modelUsageEvidence": "none",
        "reasoningEffort": {
          "mode": "arguments",
          "levels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "args": [
            "-c",
            "model_reasoning_effort={effort}"
          ],
          "requiredFlags": [
            "--config"
          ]
        }
      }
    },
    "claude": {
      "executable": "claude",
      "args": [
        "--print",
        "--verbose",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions"
      ],
      "modelFlag": "--model",
      "helpArgs": [
        "--help"
      ],
      "disabledArgs": [
        "--safe-mode"
      ],
      "coreArgs": [
        "--system-prompt",
        "__DECKENT_CORE_PROMPT__"
      ],
      "modelAliases": [
        "default",
        "best",
        "fable",
        "sonnet",
        "opus",
        "haiku",
        "sonnet[1m]",
        "opus[1m]",
        "opusplan"
      ],
      "capabilities": {
        "maxTurns": {
          "flag": "--max-turns",
          "hiddenHelpProbe": {
            "args": [
              "--max-turns",
              "invalid",
              "--print",
              "probe"
            ],
            "refusal": "option '--max-turns <turns>' argument 'invalid' is invalid. must be a number"
          }
        },
        "settings": {
          "flag": "--settings"
        },
        "discovery": {
          "requiredFlags": [
            "--safe-mode"
          ],
          "hiddenProbes": [],
          "checkout": null
        },
        "promptChannel": "claude-system-prompt",
        "eventStream": "claude-code-stream-json",
        "structuredReport": {
          "flag": "--json-schema",
          "channel": "inline-json"
        },
        "modelUsageEvidence": "session-events",
        "reasoningEffort": {
          "mode": "arguments",
          "levels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "args": [
            "--effort",
            "{effort}"
          ],
          "requiredFlags": [
            "--effort"
          ]
        }
      }
    },
    "cursor": {
      "executable": "cursor-agent",
      "args": [
        "--print",
        "--output-format",
        "stream-json",
        "--force",
        "--trust"
      ],
      "modelFlag": "--model",
      "helpArgs": [
        "--help"
      ],
      "disabledArgs": [],
      "coreArgs": [],
      "modelAliases": [],
      "capabilities": {
        "maxTurns": null,
        "settings": null,
        "discovery": {
          "requiredFlags": [],
          "hiddenProbes": [],
          "checkout": {}
        },
        "promptChannel": "inline",
        "eventStream": "cursor-agent-stream-json",
        "structuredReport": {
          "flag": null,
          "channel": "final-text-json"
        },
        "modelUsageEvidence": "session-start-name",
        "reasoningEffort": {
          "mode": "model-id",
          "levels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "args": [],
          "requiredFlags": []
        }
      }
    }
  }
}
