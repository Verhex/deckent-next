{
  "schemaVersion": 3,
  "instructionSurface": {
    "hiddenPaths": [
      "AGENTS.md",
      "CLAUDE.md",
      ".agents",
      ".claude",
      ".codex",
      ".cursor",
      "/DECKENT.md",
      "/.deckent/worker-instructions.md"
    ]
  },
  "adapters": {
    "codex": {
      "executable": "codex",
      "args": [
        "exec",
        "--json",
        "--color",
        "never",
        "--ignore-user-config",
        "-c",
        "check_for_update_on_startup=false",
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "modelFlag": "--model",
      "helpArgs": [
        "exec",
        "--help"
      ],
      "disabledArgs": [
        "--strict-config",
        "-c",
        "skills.include_instructions=false",
        "-c",
        "skills.bundled.enabled=false"
      ],
      "coreArgs": [
        "-c",
        "model_instructions_file=\"/tmp/deckent-prompt/core.txt\"",
        "-c",
        "project_doc_max_bytes=0"
      ],
      "modelAliases": [],
      "capabilities": {
        "maxTurns": null,
        "settings": null,
        "discovery": {
          "requiredFlags": [
            "--strict-config",
            "--config"
          ],
          "hiddenProbes": [
            {
              "args": [
                "exec",
                "--strict-config",
                "-c",
                "skills.include_instructions=deckent-probe"
              ],
              "refusal": "expected a boolean\nin `skills.include_instructions`"
            },
            {
              "args": [
                "exec",
                "--strict-config",
                "-c",
                "skills.bundled.enabled=deckent-probe"
              ],
              "refusal": "expected a boolean\nin `skills.bundled.enabled`"
            }
          ],
          "checkout": null
        },
        "promptChannel": "codex-instructions-file",
        "eventStream": "codex-exec-json",
        "structuredReport": {
          "flag": "--output-schema",
          "channel": "schema-file"
        },
        "modelUsageEvidence": "client-reported",
        "reasoningEffort": {
          "mode": "arguments",
          "levels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "args": [
            "-c",
            "model_reasoning_effort={effort}"
          ],
          "requiredFlags": [
            "--config"
          ]
        }
      }
    },
    "claude": {
      "executable": "claude",
      "args": [
        "--print",
        "--verbose",
        "--output-format",
        "stream-json",
        "--dangerously-skip-permissions"
      ],
      "modelFlag": "--model",
      "helpArgs": [
        "--help"
      ],
      "disabledArgs": [
        "--safe-mode"
      ],
      "coreArgs": [
        "--system-prompt",
        "__DECKENT_CORE_PROMPT__"
      ],
      "modelAliases": [
        "default",
        "best",
        "fable",
        "sonnet",
        "opus",
        "haiku",
        "sonnet[1m]",
        "opus[1m]",
        "opusplan"
      ],
      "capabilities": {
        "maxTurns": {
          "flag": "--max-turns",
          "hiddenHelpProbe": {
            "args": [
              "--max-turns",
              "invalid",
              "--print",
              "probe"
            ],
            "refusal": "option '--max-turns <turns>' argument 'invalid' is invalid. must be a number"
          }
        },
        "settings": {
          "flag": "--settings"
        },
        "discovery": {
          "requiredFlags": [
            "--safe-mode"
          ],
          "hiddenProbes": [],
          "checkout": null
        },
        "promptChannel": "claude-system-prompt",
        "eventStream": "claude-code-stream-json",
        "structuredReport": {
          "flag": "--json-schema",
          "channel": "inline-json"
        },
        "modelUsageEvidence": "session-events",
        "reasoningEffort": {
          "mode": "arguments",
          "levels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "args": [
            "--effort",
            "{effort}"
          ],
          "requiredFlags": [
            "--effort"
          ]
        }
      },
      "headless": {
        "schemaVersion": 1,
        "revision": "headless-2026-10-23",
        "source": "HEADLESS-0 measurement 2026-10-23 (CLI 2.1.309): --restricted keeps the login and drops user plugins; HOME=<run dir> + CLAUDE_CONFIG_DIR keeps the login",
        "args": [
          "--print",
          "--output-format",
          "stream-json",
          "--verbose",
          "--safe-mode",
          "--restricted",
          "--tools",
          "",
          "--strict-mcp-config",
          "--disallowedTools",
          "mcp__*",
          "--disable-slash-commands",
          "--no-session-persistence",
          "--permission-mode",
          "dontAsk",
          "--permission-prompts",
          "none"
        ],
        "maxTurns": 1,
        "systemPromptFlag": "--system-prompt-file",
        "systemPromptFile": "system.txt",
        "forbiddenFlags": [
          "--fallback-model",
          "--bare",
          "--dangerously-skip-permissions",
          "--allow-dangerously-skip-permissions",
          "--mcp-config",
          "--settings",
          "--setting-sources",
          "--add-dir",
          "--plugin-dir",
          "--continue",
          "--resume",
          "--session-id",
          "--system-prompt",
          "--append-system-prompt",
          "--json-schema",
          "--include-partial-messages",
          "--agents",
          "--max-budget-usd"
        ],
        "preflight": {
          "versionArgs": [
            "--version"
          ],
          "versionPattern": "^(\\d+\\.\\d+\\.\\d+)",
          "helpArgs": [
            "--help"
          ],
          "authStatusArgs": [
            "auth",
            "status",
            "--json"
          ]
        },
        "auth": {
          "authMethods": [
            "claude.ai"
          ],
          "apiProviders": [
            "firstParty"
          ],
          "configDirectoryMatch": true
        },
        "env": {
          "fixed": {
            "PATH": "/usr/bin:/bin",
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
            "CLAUDE_CODE_MAX_RETRIES": "0",
            "DISABLE_AUTOUPDATER": "1",
            "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
            "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
            "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
            "CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS": "1000"
          },
          "runDir": [
            "HOME",
            "TMPDIR"
          ],
          "configDir": "CLAUDE_CONFIG_DIR",
          "deny": [
            "ANTHROPIC_API_KEY",
            "ANTHROPIC_AUTH_TOKEN",
            "CLAUDE_CODE_OAUTH_TOKEN",
            "ANTHROPIC_PROFILE",
            "ANTHROPIC_BASE_URL",
            "ANTHROPIC_FOUNDRY_API_KEY",
            "AWS_BEARER_TOKEN_BEDROCK",
            "CLAUDE_CODE_USE_BEDROCK",
            "CLAUDE_CODE_USE_VERTEX",
            "CLAUDE_CODE_USE_FOUNDRY",
            "CLAUDE_CODE_RETRY_WATCHDOG"
          ]
        },
        "guards": {
          "apiKeySources": [
            "none"
          ],
          "permissionMode": "dontAsk",
          "plugins": [
            {
              "name": "cc-plugin-agents-md",
              "path": "builtin"
            },
            {
              "name": "cc-plugin-plugin-authoring",
              "path": "builtin"
            }
          ],
          "lengthStopReasons": [
            "max_tokens"
          ],
          "loginErrors": [
            "authentication_failed",
            "account_on_hold",
            "oauth_org_not_allowed"
          ],
          "creditsErrors": [
            "credits_required"
          ],
          "loginStatuses": [
            401,
            403
          ],
          "quotaStatuses": [
            429
          ]
        },
        "limits": {
          "stdinMaxBytes": 10485760,
          "maxLineBytes": 1048576,
          "stderrMaxBytes": 65536,
          "preflightTimeoutMs": 15000,
          "preflightOutputBytes": 262144,
          "killGraceMs": 3000,
          "responseFramingBytes": 65536
        }
      }
    },
    "cursor": {
      "executable": "cursor-agent",
      "args": [
        "--print",
        "--output-format",
        "stream-json",
        "--force",
        "--trust"
      ],
      "modelFlag": "--model",
      "helpArgs": [
        "--help"
      ],
      "disabledArgs": [],
      "coreArgs": [],
      "modelAliases": [],
      "capabilities": {
        "maxTurns": null,
        "settings": null,
        "discovery": {
          "requiredFlags": [],
          "hiddenProbes": [],
          "checkout": {}
        },
        "promptChannel": "inline",
        "eventStream": "cursor-agent-stream-json",
        "structuredReport": {
          "flag": null,
          "channel": "final-text-json"
        },
        "modelUsageEvidence": "session-start-name",
        "reasoningEffort": {
          "mode": "model-id",
          "levels": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "args": [],
          "requiredFlags": []
        }
      }
    }
  }
}
