      ],
      "goal": {
        "tr": "İlk yanıtı açık zeminde oku; /theme önizlemesini gez, Esc ile vazgeç, Enter ile seç, yeniden açıp kalıcılığı kontrol et; /mcp durumlarını sözcük ve simgelerle ayırt et.",
        "en": "Read the first answer on a light background; explore /theme preview, cancel with Esc, apply with Enter and reopen to check persistence; distinguish /mcp states by word and glyph."
      }
    },
    {
      "id": "TL-B2",
      "personaIds": [
        "zeynep"
      ],
      "goal": {
        "tr": "/theme içindeki dokuz seçimi ve canlı önizlemeyi incele; Esc ile geri dön, Enter ile uygula ve yeniden başlatınca seçimi bul.",
        "en": "Inspect nine /theme choices and live preview; cancel with Esc, apply with Enter and find the choice after restart."
      }
    },
    {
      "id": "TL-B3",
      "personaIds": [
        "mert"
      ],
      "goal": {
        "tr": "Proje temasının kurulum ayarını gölgelediğini gör; yazılacak katmanı ve ret durumunda sonraki adımı bul.",
        "en": "See project theme shadowing installation settings; identify the written layer and next step on refusal."
      }
    },
    {
      "id": "TL-B4",
      "personaIds": [
        "zeynep"
      ],
      "goal": {
        "tr": "Yanıtsız terminalde başlangıcın sınırlı sürede bittiğini, metnin okunur kaldığını gör; /theme ve /mcp aç.",
        "en": "With no terminal reply, see bounded startup and readable text; open /theme and /mcp."
      }
    },
    {
      "id": "TL-B5",
      "personaIds": [
        "zeynep"
      ],
      "goal": {
        "tr": "Geç terminal cevabının yazı alanına düşmediğini, önceki tuşların sırasını ve Ctrl+C davranışını kontrol et.",
        "en": "Check that a late terminal reply never enters the composer; preserve earlier key order and normal Ctrl+C."
      }
    },
    {
      "id": "TL-B6",
      "personaIds": [
        "mert"
      ],
      "goal": {
        "tr": "OSC cevabı yokken COLORFGBG ile okunur temayı gör; /theme kaynağını incele.",
        "en": "Without OSC, see a readable theme selected from COLORFGBG and inspect the source in /theme."
      }
    },
    {
      "id": "TL-B7",
      "personaIds": [
        "zeynep"
      ],
      "goal": {
        "tr": "/mcp aç; yoklanmış bağlı sunucu ile başlamamış, başarısız ve onay bekleyen durumları simge ve sözcüklerle ayırt et; pencereyi kapat.",
        "en": "Open /mcp; distinguish probed connected, not-started, failed and approval-pending states by glyph and word; close the window."
      }
    },
    {
      "id": "TL-B8",
      "personaIds": [
        "screen-reader",
        "narrow-terminal"
      ],
      "goal": {
        "tr": "Renksiz dar terminalde /theme seçimini yap; /mcp durumlarını renksiz sözcük ve simgelerle ayırt et.",
        "en": "Use /theme without colour in a narrow terminal; distinguish /mcp states by glyph and word."
      }
    },
    {
      "id": "TL-B9",
      "personaIds": [
        "zeynep"
      ],
      "goal": {
        "tr": "Yanıtta paragraf, başlık, liste ve kod arasındaki boşluğu oku; yinelenen MCP bildirimlerini kontrol et.",
        "en": "Read spacing between paragraphs, headings, lists and code; check repeated MCP notices."
      }
    },
    {
      "id": "TL-B10",
      "personaIds": [
        "zeynep"
      ],
      "goal": {
        "tr": "Tema değişince eski terminal geçmişinin renkleri koruduğunu açıklayan satırı bul.",
        "en": "Find the explanation that previously printed scrollback keeps its colours after a theme change."
