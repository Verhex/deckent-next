# Shared recording settings: about 120x34 cells, JetBrains Mono (OFL), the deckent dark brand surface (#191B1A / #E7E3D9).
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 14
Set LineHeight 1.15
Set Padding 16
Set Width 1152
Set Height 752
Set Framerate 25
Set WindowBar ""
Set CursorBlink false
Set TypingSpeed 45ms
Set Theme { "name": "deckent-dark", "background": "#191B1A", "foreground": "#E7E3D9", "cursor": "#6CCFAE", "selection": "#153B39", "black": "#191B1A", "red": "#F0806E", "green": "#9BE3A6", "yellow": "#F2B24A", "blue": "#A9BFD6", "magenta": "#C9A8D8", "cyan": "#6CCFAE", "white": "#E7E3D9", "brightBlack": "#A8A89C", "brightRed": "#F0806E", "brightGreen": "#9BE3A6", "brightYellow": "#F2B24A", "brightBlue": "#A9BFD6", "brightMagenta": "#C9A8D8", "brightCyan": "#6CCFAE", "brightWhite": "#F4F5F2" }
