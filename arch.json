  "composition": {
    "enforceDomainDecisionImports": true
  },
  "vocabulary": {
    "canonicalChain": [
      "Goal",
      "Mission",
      "Flow",
      "Run",
      "WorkItem",
      "Attempt",
      "Operation"
    ],
    "forbidden": [
      "\\b[sS]print\\w*"
    ],
    "scope": [
      "src",
      "tests",
      "scripts"
    ],
    "enforce": true,
    "note": "Canonical run terminology is enforced across product source, tests and scripts; no legacy aliases."
  },
  "budgets": {
    "maxLinesPerFile": 1500,
    "packageLines": {
      "platform": 25000,
      "domain": 10000,
      "capabilities": 25000,
      "engine": 60000,
      "adapters": 25000,
      "surfaces": 45000,
      "composition": 5000
    },
    "totalSrcLines": 200000,
    "testCases": 8000,
    "designTargetLines": 800,
    "fileRoots": [
      "src",
      "scripts",
      "tests",
      "apps",
      "native"
    ],
    "textExtensions": [
      ".ts",
      ".tsx",
      ".mts",
      ".cts",
      ".js",
      ".mjs",
      ".cjs",
      ".json",
      ".sh",
      ".yml",
      ".yaml",
      ".go",
      ".c",
      ".h",
      ".cc",
      ".cpp",
      ".hpp",
      ".rs",
      ".py"
    ],
    "evidenceFiles": [
