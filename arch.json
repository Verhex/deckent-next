  },
  "literals": {
    "forbidden": [
      "\\bclaude-[0-9][0-9a-z.-]*\\b",
      "\\bgpt-[0-9][0-9a-z.-]*\\b",
      "\\bgemini-[0-9][0-9a-z.-]*\\b",
      "\\bo[134]-(mini|pro|preview)\\b",
      "\\b(sonnet|opus|haiku)\\b",
      "\\b(ANTHROPIC|OPENAI|GOOGLE|GEMINI|XAI)_API_KEY\\b"
    ],
    "allow": []
  },
  "markdown": {
    "trackedAllow": [
