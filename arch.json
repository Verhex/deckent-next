{
  "$schema": "./scripts/arch.schema.json",
  "version": 1,
  "packages": {
    "platform": {
      "imports": []
    },
    "domain": {
      "imports": [],
      "pure": true,
      "externalImports": [
        "zod"
      ]
    },
    "capabilities": {
      "imports": [
        "platform",
        "domain"
      ]
    },
    "engine": {
      "imports": [
        "platform",
        "domain",
        "capabilities"
      ]
    },
    "adapters": {
      "imports": [
        "platform",
        "domain",
        "capabilities",
        "engine"
      ]
    },
    "surfaces": {
      "imports": [
        "platform",
        "domain",
        "capabilities",
        "engine"
      ]
    },
    "composition": {
      "imports": [
        "platform",
        "domain",
        "capabilities",
        "engine",
        "adapters",
        "surfaces"
      ]
    }
  },
  "apps": {
    "imports": [
      "surfaces"
    ]
  },
  "tiers": {
    "order": [
      "core",
      "base",
      "enterprise",
      "custom",
      "user"
    ],
    "enforce": true,
    "unitLines": 4000,
    "note": "Lower tiers import only lower/same-tier unit index.ts; package index.ts composes shipped units. Optional editions are loaded lazily when implemented."
  },
  "imports": {
    "aliasPrefix": "#",
    "enforce": true,
    "note": "Cross-unit/package imports use native subpath imports through public indexes; relative paths stay inside a unit."
  },
  "vocabulary": {
    "canonicalChain": [
      "Goal",
      "Mission",
      "Flow",
      "Run",
      "WorkItem",
      "Attempt",
      "Operation"
    ],
    "forbidden": [
      "\\b[sS]print\\w*"
    ],
    "scope": [
      "src",
      "tests",
      "scripts"
    ],
    "enforce": false,
    "note": "Catalog uses canonical run terminology. Code-wide vocabulary enforcement and the accepted Task/Run/Attempt/Operation/Effect ontology are reconciled in CONTRACT; no legacy aliases."
  },
  "budgets": {
    "maxLinesPerFile": 1500,
    "packageLines": {
      "platform": 25000,
      "domain": 10000,
      "capabilities": 25000,
      "engine": 60000,
      "adapters": 25000,
      "surfaces": 45000,
      "composition": 5000
    },
    "totalSrcLines": 200000,
    "testCases": 8000,
    "designTargetLines": 800,
    "fileRoots": [
      "src",
      "scripts",
      "tests",
      "apps",
      "native"
    ],
    "textExtensions": [
      ".ts",
      ".tsx",
      ".mts",
      ".cts",
      ".js",
      ".mjs",
      ".cjs",
      ".json",
      ".sh",
      ".yml",
      ".yaml",
      ".go",
      ".c",
      ".h",
      ".cc",
      ".cpp",
      ".hpp",
      ".rs",
      ".py"
    ],
    "evidenceFiles": [
      "tests/contracts/HARVEST.json"
    ]
  },
  "i18n": {
    "catalogDir": "src/platform/core/i18n",
    "locales": [
      "en",
      "tr"
    ],
    "callee": "t",
    "families": [
      "cli",
      "tui",
      "run",
      "ops",
      "surface",
      "governance",
      "remote",
      "native",
      "desktop",
      "misc"
    ]
  },
  "literals": {
    "forbidden": [
      "\\bclaude-[0-9][0-9a-z.-]*\\b",
      "\\bgpt-[0-9][0-9a-z.-]*\\b",
      "\\bgemini-[0-9][0-9a-z.-]*\\b",
      "\\bo[134]-(mini|pro|preview)\\b",
      "\\b(sonnet|opus|haiku)\\b",
      "\\b(ANTHROPIC|OPENAI|GOOGLE|GEMINI|XAI)_API_KEY\\b"
    ],
    "allow": [
      "src/adapters/core/registry/internal/auth.ts"
    ]
  },
  "markdown": {
    "trackedAllow": [
      "README.md",
      "ARCHITECTURE.md",
      "PLAN.md",
      "CHANGELOG.md"
    ],
    "pointerFiles": {
      "CLAUDE.md": 5,
      "AGENTS.md": 5
    },
    "writerModule": "src/platform/core/docs-authority/"
  }
}
