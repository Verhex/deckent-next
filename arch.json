    ]
  },
  "i18n": {
    "catalogDir": "src/platform/core/i18n",
    "locales": [
      "en",
      "tr"
    ],
    "callee": "t",
    "families": [
      "cli",
      "tui",
      "run",
      "ops",
      "surface",
      "governance",
      "remote",
      "native",
      "desktop",
      "misc"
